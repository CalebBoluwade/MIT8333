# Create a database at https://turso.tech and paste its URL/token here
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# Use a long random secret (at least 32 characters)
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional initial admin user used by `npm run db:seed`
SEED_ADMIN_NAME=UniFix Administrator
SEED_ADMIN_EMAIL=admin@university.edu
SEED_ADMIN_PASSWORD=change-this-to-a-strong-password
